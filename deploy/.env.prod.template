# Copy to /srv/apps/bookings/prod/.env on the VPS. chmod 600 immediately.

APP_NAME="VATSSA Bookings"
APP_ENV=production
APP_KEY=            # php artisan key:generate --show — FRESH, never reuse staging's
APP_DEBUG=false
APP_URL=https://bookings.vatssa.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

# === Database ===
DB_CONNECTION=mysql
DB_HOST=vatssa-mysql
DB_PORT=3306
DB_DATABASE=bmac_prod
DB_USERNAME=bmac_prod_user
DB_PASSWORD=<prod-password>
DB_TABLE_PREFIX=
DB_LOWER_STRING_LENGTH=false

# === Cache / session / queue ===
BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

REDIS_HOST=vatssa-redis
REDIS_PASSWORD=<redis-password>
REDIS_PORT=6379

# === Auth — through Handover-prod (register BMAC as a client there) ===
OAUTH_BASE=https://handover.vatssa.com
OAUTH_CLIENT=<bmac-prod-client-id-from-handover>
OAUTH_SECRET=<bmac-prod-client-secret-from-handover>

# === Mail — Brevo SMTP (pilots see these on booking confirmation emails) ===
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=tech@vatssa.com
MAIL_PASSWORD=<brevo-smtp-key>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=bookings@vatssa.com
MAIL_FROM_NAME="VATSSA Bookings"

# === Branding ===
SITE_TITLE="VATSSA Bookings"
SITE_DIVISION="VATSIM Sub-Saharan Africa"
SITE_DIVISION_URL="https://vatssa.com"
SITE_CONTACT_MAIL="events@vatssa.com"
SITE_PILOTBRIEF_URL="https://vatssa.com"
SITE_CHARTS_URL="https://docs.vatssa.com"

# VATSSA palette
BOOTSTRAP_COLOR_PRIMARY="#0197B0"
BOOTSTRAP_COLOR_SECONDARY="#07262C"
BOOTSTRAP_COLOR_TERTIARY="#7BD758"
BOOTSTRAP_COLOR_SUCCESS="#7BD758"
BOOTSTRAP_COLOR_DANGER="#E74C3C"
BOOTSTRAP_COLOR_WARNING="#F39C12"

ACTIVITY_LOGGER_ENABLED=true
TELESCOPE_ENABLED=false
