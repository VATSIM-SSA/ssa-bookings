# /srv/apps/bookings/prod/.env   — chmod 600
# Fill every <placeholder>. Never commit a filled copy.
# APP_KEY must be freshly generated — never reuse the staging key.

APP_NAME="VATSSA Bookings"
APP_ENV=production
APP_KEY=<generate fresh: openssl rand -base64 32 | sed 's/^/base64:/'>
APP_DEBUG=false
APP_URL=https://bookings.vatssa.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=vatssa-mysql
DB_PORT=3306
DB_DATABASE=bmac_prod
DB_USERNAME=bmac_prod_user
DB_PASSWORD=<bmac_prod_user password from the password manager>

QUEUE_CONNECTION=sync
CACHE_STORE=file
SESSION_DRIVER=file

# OAuth — Handover PRODUCTION.
OAUTH_BASE=https://handover.vatssa.com
OAUTH_CLIENT=<handover prod client id>
OAUTH_SECRET=<handover prod client secret>
OAUTH_SCOPES="full_name,email"
OAUTH_MAPPING_CID=data-cid
OAUTH_MAPPING_FIRSTNAME=data-personal-name_first
OAUTH_MAPPING_LASTNAME=data-personal-name_last
OAUTH_MAPPING_EMAIL=data-personal-email

# Mail — Brevo SMTP. Pilots see bookings@vatssa.com on booking emails.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=<brevo smtp login>
MAIL_PASSWORD=<brevo smtp key>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=bookings@vatssa.com
MAIL_FROM_NAME="VATSSA Bookings"

SITE_TITLE="VATSSA Bookings"
SITE_DIVISION="VATSIM Sub-Saharan Africa"
SITE_DIVISION_URL=https://vatssa.com
SITE_CONTACT_MAIL=bookings@vatssa.com

SENTRY_LARAVEL_DSN=
