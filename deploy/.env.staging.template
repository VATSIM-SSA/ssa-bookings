# /srv/apps/bookings/staging/.env   — chmod 600
# Fill every <placeholder>. Never commit a filled copy.

APP_NAME="VATSSA Bookings (Staging)"
APP_ENV=staging
APP_KEY=<generate: openssl rand -base64 32 | sed 's/^/base64:/'>
APP_DEBUG=true
APP_URL=https://bookings-staging.vatssa.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=vatssa-mysql
DB_PORT=3306
DB_DATABASE=bmac_staging
DB_USERNAME=bmac_staging_user
DB_PASSWORD=<bmac_staging_user password from the password manager>

# sync keeps emails/exports inline — no queue worker container needed yet.
QUEUE_CONNECTION=sync
CACHE_STORE=file
SESSION_DRIVER=file

# OAuth — Handover STAGING, not VATSIM directly.
OAUTH_BASE=https://handover-staging.vatssa.com
OAUTH_CLIENT=<handover staging client id>
OAUTH_SECRET=<handover staging client secret>
OAUTH_SCOPES="full_name,email"
OAUTH_MAPPING_CID=data-cid
OAUTH_MAPPING_FIRSTNAME=data-personal-name_first
OAUTH_MAPPING_LASTNAME=data-personal-name_last
OAUTH_MAPPING_EMAIL=data-personal-email

# Mail — log driver on staging so no test mail reaches real pilots.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=bookings@vatssa.com
MAIL_FROM_NAME="VATSSA Bookings (Staging)"

SITE_TITLE="VATSSA Bookings (Staging)"
SITE_DIVISION="VATSIM Sub-Saharan Africa"
SITE_DIVISION_URL=https://vatssa.com
SITE_CONTACT_MAIL=bookings@vatssa.com

SENTRY_LARAVEL_DSN=
