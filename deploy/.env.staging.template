# Copy to /srv/apps/bookings/staging/.env on the VPS. chmod 600 immediately.

APP_NAME="VATSSA Bookings (Staging)"
APP_ENV=staging
APP_KEY=            # php artisan key:generate --show, run once
APP_DEBUG=true
APP_URL=https://bookings-staging.vatssa.com

LOG_CHANNEL=stack
LOG_LEVEL=debug

# === Database ===
DB_CONNECTION=mysql
DB_HOST=vatssa-mysql
DB_PORT=3306
DB_DATABASE=bmac_staging
DB_USERNAME=bmac_staging_user
DB_PASSWORD=<staging-password>
DB_TABLE_PREFIX=
DB_LOWER_STRING_LENGTH=false

# === Cache / session / queue ===
# QUEUE_CONNECTION=sync runs jobs inline (no Horizon worker needed). Switch to
# redis + a horizon container later if booking-email volume warrants it.
BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

REDIS_HOST=vatssa-redis
REDIS_PASSWORD=<redis-password>
REDIS_PORT=6379

# === Auth — through Handover-staging (register BMAC as a client there) ===
OAUTH_BASE=https://handover-staging.vatssa.com
OAUTH_CLIENT=<bmac-staging-client-id-from-handover>
OAUTH_SECRET=<bmac-staging-client-secret-from-handover>
# Leave the OAUTH_MAPPING_* keys at their defaults — Handover mirrors the
# VATSIM Connect data shape.

# === Mail — log only on staging (no real sends) ===
MAIL_MAILER=log
MAIL_FROM_ADDRESS=bookings@vatssa.com
MAIL_FROM_NAME="VATSSA Bookings"

# === Branding ===
SITE_TITLE="VATSSA Bookings"
SITE_DIVISION="VATSIM Sub-Saharan Africa"
SITE_DIVISION_URL="https://vatssa.com"
SITE_CONTACT_MAIL="events@vatssa.com"
SITE_PILOTBRIEF_URL="https://vatssa.com"
SITE_CHARTS_URL="https://docs.vatssa.com"

# VATSSA palette
BOOTSTRAP_COLOR_PRIMARY="#0197B0"
BOOTSTRAP_COLOR_SECONDARY="#07262C"
BOOTSTRAP_COLOR_TERTIARY="#7BD758"
BOOTSTRAP_COLOR_SUCCESS="#7BD758"
BOOTSTRAP_COLOR_DANGER="#E74C3C"
BOOTSTRAP_COLOR_WARNING="#F39C12"

ACTIVITY_LOGGER_ENABLED=true
TELESCOPE_ENABLED=false
